# Keep shareable VS Code workspace config in git
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/extensions.json

# Claude Code — celý adresár je lokálny (rovnaká logika ako nefro)
.claude/

# Citlivé súbory — nikdy do gitu
.env
*.env
*.ini
!env.ini.example
*.pem
*.key
*.p12
*.pfx
private/

# Lokálne pomocné súbory
code.txt

# Generuje sa pri nasadení (workflow aj hooks/deploy.sh), do gitu nepatrí
deploy_info.php

# PHP session / cache
private/sessions/
private/cache/
private/logs/
