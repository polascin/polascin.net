<?xml version="1.0" encoding="UTF-8"?>
<!--
  Zoznam adries generuje sitemap.php: jazykové varianty statických stránok,
  všetky publikované články a k nim xhtml:link alternatívy.

  Tento súbor je iba index. Apache prepisuje /sitemap.xml priamo na sitemap.php
  (.htaccess) a na produkcii sa tento prepis uplatňuje (Beh #5, nález 10 —
  OpenResty je predsadená proxy pred Apache, ktorý .htaccess číta; overené
  v Behu #19: /sitemap.xml a /sitemap.php vracajú bajtovo identický výstup).
  Index tu zostáva ako obrana do hĺbky: keby mod_rewrite prepis neuplatnil,
  na /sitemap.xml sa podá platný index namiesto zastaraného zoznamu adries.
-->
<sitemapindex xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <sitemap>
    <loc>https://polascin.net/sitemap.php</loc>
  </sitemap>
</sitemapindex>
