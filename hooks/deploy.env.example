# Konfigurácia pre lokálny deploy polascin.net
# Skopíruj tento súbor napr. do ~/.config/polascin/deploy.env a vyplň hodnoty.
# Tento súbor sa nesmie dostať do gitu!

# Variant A: použi SSH config host (odporúčané)
# V ~/.ssh/config musí byť definovaný host polascin s User/HostName/Port/IdentityFile.
POLASCIN_DEPLOY_TARGET=polascin

# Variant B: explicitné pripojenie
# POLASCIN_DEPLOY_HOST=shell.r1.websupport.sk
# POLASCIN_DEPLOY_PORT=22
# POLASCIN_DEPLOY_USER=uid12345
# POLASCIN_SSH_KEY=$HOME/.ssh/polascin_deploy

# Cieľová cesta na serveri (absolútna cesta k web rootu)
POLASCIN_REMOTE_PATH=/data/.../polascin.net

# Voliteľné: automatické nahratie env.ini na server pri deployi.
# Buď cesta k súboru s obsahom env.ini:
# POLASCIN_ENV_INI_FILE=$HOME/.config/polascin/env.ini
#
# Alebo celý obsah premennej (vhodné pre GitHub Actions secret):
# POLASCIN_ENV_INI='APP_BASE_URL=https://polascin.net
# DB_HOST=localhost
# DB_NAME=polascin
# DB_USER=polascin_user
# DB_PASS=CHANGE_ME
# '
#
# Cieľová cesta: absolútna a mimo REMOTE_PATH (relatívnu skript odmietne).
# Predvolene <rodič-REMOTE_PATH>/private/polascin.env.ini
# POLASCIN_ENV_PATH=/data/uid12345/private/polascin.env.ini

# Heslo pre prvý admin účet pri vytváraní databázy (len pri prvej inštalácii)
# POLASCIN_ADMIN_PASSWORD=CHANGE_ME
